---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const articles = await getCollection("articles");
const total = articles.length;

const counts = new Map<string, number>();
for (const entry of articles) {
  counts.set(entry.data.category, (counts.get(entry.data.category) ?? 0) + 1);
}
const topics = [...counts.entries()].sort(
  ([nameA, countA], [nameB, countB]) => countB - countA || nameA.localeCompare(nameB),
);
---

<BaseLayout title="关于" description="关于十六的站点说明">
  <section class="page-heading">
    <p class="eyebrow">// about</p>
    <h1>关于</h1>
    <p class="role">
      软件工程师 · <span class="mono">C++ / Qt / Electron</span>
    </p>
  </section>

  <section class="about-copy">
    <div class="about-grid">
      <article class="panel">
        <h2>站点说明</h2>
        <p>
          平时做工程顺手记下的东西：C++、Qt、Electron 的问题排查，以及最近在整理的 EDA / OrCAD 笔记。
        </p>
        <p>上班踩的坑，下班记下来。</p>
      </article>
      <article class="panel">
        <h2>技术分类</h2>
        <ul class="stack-list">
          {topics.map(([name, count]) => (
            <li>
              <a href={`${base}articles/?category=${encodeURIComponent(name)}`}>
                {name}<span class="stack-list__count">{String(count).padStart(2, "0")}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
      <article class="panel">
        <h2>站点信息</h2>
        <p>当前收录 <span class="mono">{total}</span> 篇文章，按发布日期归档。</p>
        <p class="mono">static · astro · github pages</p>
      </article>
    </div>
  </section>
</BaseLayout>
