---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { filterAndSortArticles, type ArticleItem } from "../lib/articles";

const base = import.meta.env.BASE_URL;

const articles = (await getCollection("articles")).map(
  (article): ArticleItem => ({
    slug: article.data.slug,
    title: article.data.title,
    summary: article.data.summary,
    category: article.data.category,
    publishedAt: article.data.publishedAt.toISOString().slice(0, 10),
    readingTime: article.data.readingTime,
  }),
);

const newest = filterAndSortArticles(articles, {
  query: "",
  category: "",
  sort: "newest",
});
const selected = newest.slice(0, 3);
const recent = newest.slice(3, 9);

const topicCounts = new Map<string, number>();
for (const article of articles) {
  topicCounts.set(article.category, (topicCounts.get(article.category) ?? 0) + 1);
}

const topics = [...topicCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort(
    (left, right) =>
      right.count - left.count || left.name.localeCompare(right.name, "zh-CN"),
  );

const sinceYear =
  articles.length > 0
    ? Math.min(...articles.map((article) => Number(article.publishedAt.slice(0, 4))))
    : new Date().getFullYear();
---

<BaseLayout description="十六：软件工程师。记录 C++、Qt、Electron、Chromium 与系统底层的工程实践。">
  <Hero
    articleCount={articles.length}
    topicCount={topics.length}
    sinceYear={sinceYear}
    latestTitle={newest[0]?.title}
    latestCategory={newest[0]?.category}
    latestReadingTime={newest[0]?.readingTime}
  />

  <section class="home-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">// topics</p>
        <h2>技术方向</h2>
      </div>
      <a class="section-link" href={`${base}articles`}>
        全部文章 <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="topic-grid">
      {
        topics.map((topic, index) => (
          <li class="topic">
            <a
              class="topic__link"
              href={`${base}articles/?category=${encodeURIComponent(topic.name)}`}
            >
              <span class="topic__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="topic__name">{topic.name}</span>
              <span class="topic__count">{topic.count} 篇</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">// featured</p>
        <h2>精选文章</h2>
      </div>
      <a class="section-link" href={`${base}articles`}>
        查看全部 <span aria-hidden="true">→</span>
      </a>
    </div>
    {
      selected.length === 0 ? (
        <p class="empty-state">文章内容迁移完成后将在此展示。</p>
      ) : (
        <ol class="post-grid">
          {selected.map((article, index) => (
            <ArticleCard article={article} headingLevel={3} index={index} />
          ))}
        </ol>
      )
    }
  </section>

  <section class="home-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">// latest</p>
        <h2>最近文章</h2>
      </div>
    </div>
    {
      recent.length === 0 ? (
        <p class="empty-state">暂无更多文章。</p>
      ) : (
        <ol class="post-list">
          {recent.map((article, index) => (
            <ArticleCard
              article={article}
              headingLevel={3}
              variant="row"
              index={index + selected.length}
            />
          ))}
        </ol>
      )
    }
  </section>

  <section class="home-section">
    <div class="about-band">
      <div>
        <p class="eyebrow">// about</p>
        <h2>关于本站</h2>
        <p>
          这里放的是做工程时记下的笔记：C++、Qt、Electron 的问题排查，以及 EDA / OrCAD 相关的整理。
        </p>
      </div>
      <a class="btn btn--ghost" href={`${base}about`}>
        了解更多 <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
