---
interface Props {
  articleCount: number;
  topicCount: number;
  sinceYear: number;
}

const { articleCount, topicCount, sinceYear } = Astro.props;
const base = import.meta.env.BASE_URL;
const articlesHref = `${base}articles`;
const aboutHref = `${base}about`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">
        <span class="pulse-dot" aria-hidden="true"></span>
        software engineer · system online
      </p>
      <h1 id="hero-title" class="hero__title">
        十六<span class="hero__dot">.</span>
      </h1>
      <p class="hero__lede">
        把工程现场写下来。从 Chromium 编译、Qt 界面到系统底层，记录<strong
          >能复现、能落地</strong
        >的解决过程。
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={articlesHref}>
          浏览全部文章
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={aboutHref}>关于本站</a>
      </div>
      <dl class="hero__stats">
        <div>
          <dt>articles</dt>
          <dd>{articleCount}</dd>
        </div>
        <div>
          <dt>topics</dt>
          <dd>{topicCount}</dd>
        </div>
        <div>
          <dt>since</dt>
          <dd>{sinceYear}</dd>
        </div>
        <div>
          <dt>visitors</dt>
          <dd id="hero_visitors">--</dd>
        </div>
      </dl>
    </div>

    <div class="hero__panel">
      <div class="terminal" aria-hidden="true">
        <div class="terminal__bar">
          <span class="terminal__dot terminal__dot--accent"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__dot"></span>
          <span class="terminal__title">sixteen@dev — zsh</span>
        </div>
        <pre class="terminal__body"><code><span class="t-prompt">$</span> <span class="t-cmd">whoami</span>
<span class="t-out">十六 · software engineer</span>

<span class="t-prompt">$</span> <span class="t-cmd">cat focus.txt</span>
<span class="t-key">C++</span> · <span class="t-key">Qt</span> · <span class="t-key">Electron</span> · <span class="t-key">Linux</span>

<span class="t-prompt">$</span> <span class="t-cmd">ls ~/articles | wc -l</span>
<span class="t-out">{articleCount}</span>

<span class="t-prompt">$</span> <span class="t-comment"># 把工程现场写下来</span>
<span class="t-prompt">$</span> <span class="t-cursor"></span></code></pre>
      </div>
    </div>
  </div>
</section>
