---
const base = import.meta.env.BASE_URL;

interface Props {
  articleCount: number;
  topicCount: number;
  sinceYear: number;
  latestTitle?: string;
  latestCategory?: string;
  latestReadingTime?: number;
}

const {
  articleCount,
  topicCount,
  sinceYear,
  latestTitle,
  latestCategory,
  latestReadingTime,
} = Astro.props;

const shortTitle = (() => {
  if (!latestTitle) return "写 C++、Qt 与 Electron，也拆系统底层。";
  const limit = 30;
  return latestTitle.length > limit ? `${latestTitle.slice(0, limit)}…` : latestTitle;
})();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <span class="hero__kicker">software engineer · nantong, cn</span>
    <h1 id="hero-title" class="hero__title">
      十六<span class="hero__dot">.</span>
    </h1>
    <p class="hero__lede">
      写 C++、Qt、Electron 与 Chromium，也拆系统底层。把工程现场记录成可复用的笔记——不追热点，只留能跑通的方法。
    </p>
    <div class="hero__actions">
      <a class="btn" href={`${base}articles`}>浏览文章 →</a>
      <a class="btn btn--ghost" href={`${base}about`}>关于我</a>
    </div>
    <dl class="hero__stats">
      <div class="hero__stat">
        <dt>articles</dt>
        <dd>{articleCount}</dd>
      </div>
      <div class="hero__stat">
        <dt>topics</dt>
        <dd>{topicCount}</dd>
      </div>
      <div class="hero__stat">
        <dt>since</dt>
        <dd>{sinceYear}</dd>
      </div>
      <div class="hero__stat">
        <dt>visitors</dt>
        <dd id="hero_visitors">--</dd>
      </div>
    </dl>
  </div>

  <div class="hero__stack" aria-hidden="true">
    <div class="sticker sticker--focus">
      <span class="sticker__k">focus</span>
      <div class="sticker__v">C++ / QT<br />ELECTRON</div>
    </div>
    <div class="sticker sticker--status">
      <span class="sticker__k">system status</span>
      <div class="sticker__v">ONLINE ✓</div>
    </div>
    <div class="sticker sticker--note">
      <div class="sticker__tape"></div>
      <span class="sticker__k">latest note</span>
      <div class="sticker__v">{shortTitle}</div>
      <div class="sticker__mini">
        {latestCategory ?? "ENGINEERING"} · {latestReadingTime ?? 1} MIN READ
      </div>
    </div>
  </div>
</section>
