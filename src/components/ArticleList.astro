---
import ArticleCard from "./ArticleCard.astro";
import { collectCategories, type ArticleItem } from "../lib/articles";

interface Props {
  articles: ArticleItem[];
}

const { articles } = Astro.props;
const categories = collectCategories(articles);
const base = import.meta.env.BASE_URL;
---

<div class="article-directory" data-articles={JSON.stringify(articles)} data-base={base}>
  <form class="article-controls" role="search" onsubmit="return false">
    <label class="article-control">
      <span>搜索</span>
      <input
        id="article-search"
        type="search"
        placeholder="搜索标题、摘要或分类"
        autocomplete="off"
      />
    </label>
    <label class="article-control">
      <span>分类</span>
      <select id="article-category">
        <option value="">全部分类</option>
        {categories.map((category) => <option value={category}>{category}</option>)}
      </select>
    </label>
    <label class="article-control">
      <span>排序</span>
      <select id="article-sort">
        <option value="newest">最新优先</option>
        <option value="oldest">最早优先</option>
        <option value="title-asc">标题升序</option>
        <option value="title-desc">标题降序</option>
      </select>
    </label>
  </form>

  <p class="article-result-count" aria-live="polite">
    <span id="article-result-count">共 {articles.length} 篇</span>
  </p>

  <div id="article-empty" class="empty-state" hidden={articles.length > 0}>
    没有符合条件的文章。
  </div>

  <ol class="article-list" id="article-list">
    {articles.map((article) => (
      <ArticleCard article={article} headingLevel={2} />
    ))}
  </ol>
</div>

<script>
  import {
    filterAndSortArticles,
    type ArticleItem,
    type SortOrder,
  } from "../lib/articles";

  const root = document.querySelector<HTMLElement>(".article-directory")!;
  const articles = JSON.parse(root.dataset.articles ?? "[]") as ArticleItem[];
  const base = root.dataset.base ?? "";
  const search = document.querySelector<HTMLInputElement>("#article-search")!;
  const category = document.querySelector<HTMLSelectElement>("#article-category")!;
  const sort = document.querySelector<HTMLSelectElement>("#article-sort")!;
  const list = document.querySelector<HTMLOListElement>("#article-list")!;
  const count = document.querySelector<HTMLElement>("#article-result-count")!;
  const empty = document.querySelector<HTMLElement>("#article-empty")!;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[character] ?? character;
    });

  function render() {
    const filtered = filterAndSortArticles(articles, {
      query: search.value,
      category: category.value,
      sort: sort.value as SortOrder,
    });

    count.textContent = `共 ${filtered.length} 篇`;
    empty.hidden = filtered.length > 0;
    list.innerHTML = filtered
      .map(
        (article) => `
          <li class="article-card">
            <article class="article-entry">
              <h2 class="article-entry__title">
                <a href="${base}articles/${escapeHtml(article.slug)}/">${escapeHtml(article.title)}</a>
              </h2>
              <p class="article-meta">
                <time datetime="${escapeHtml(article.publishedAt)}">${escapeHtml(article.publishedAt.slice(0, 10))}</time>
                <span aria-hidden="true"> · </span>
                <span class="article-meta__category">${escapeHtml(article.category)}</span>
                <span aria-hidden="true"> · </span>
                <span>约 ${article.readingTime} 分钟</span>
              </p>
              <p class="article-entry__summary">${escapeHtml(article.summary)}</p>
            </article>
          </li>
        `,
      )
      .join("");
  }

  search.addEventListener("input", render);
  category.addEventListener("change", render);
  sort.addEventListener("change", render);
  render();
</script>
