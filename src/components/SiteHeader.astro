---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const navItems = [
  { label: "首页", href: base, index: "01" },
  { label: "文章", href: `${base}articles`, index: "02" },
  { label: "关于", href: `${base}about`, index: "03" },
];

const normalize = (value: string) => value.replace(/\/+$/, "") || "/";
const current = normalize(path);

const isActive = (href: string) => {
  const target = normalize(href);
  if (target === "/") return current === "/";
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-name" href={base} aria-label="十六 · 首页">
      <span class="site-name__mark" aria-hidden="true">十</span>
      <span>十六</span>
      <span class="site-name__path" aria-hidden="true">/blog</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            class:list={["site-nav__link", { "is-active": isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span class="site-nav__index" aria-hidden="true">{item.index}</span>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
