---
import type { ArticleItem } from "../lib/articles";
import { categoryTone } from "../lib/category-color";

interface Props {
  article: ArticleItem;
  headingLevel?: 2 | 3;
  index?: number;
  variant?: "card" | "row";
}

const { article, headingLevel = 2, index, variant = "card" } = Astro.props;
const base = import.meta.env.BASE_URL;
const articleHref = `${base}articles/${article.slug}/`;
const indexLabel =
  typeof index === "number" ? String(index + 1).padStart(2, "0") : undefined;
const tone = categoryTone(article.category);
---

<li class:list={["post", { "post--row": variant === "row" }]}>
  <a class="post__link" href={articleHref}>
    {
      indexLabel ? (
        <span class="post__index" aria-hidden="true">
          {indexLabel}
        </span>
      ) : null
    }
    <div class="post__main">
      {
        headingLevel === 2 ? (
          <h2 class="post__title">{article.title}</h2>
        ) : (
          <h3 class="post__title">{article.title}</h3>
        )
      }
      <p class="post__summary">{article.summary}</p>
    </div>
    <div class="post__meta">
      <span class="post__cat" data-tone={tone}>{article.category}</span>
      <time class="post__date" datetime={article.publishedAt}>{article.publishedAt}</time>
      <span class="post__read">{article.readingTime} min</span>
    </div>
    <span class="post__arrow" aria-hidden="true">→</span>
  </a>
</li>
